# =====================================================
# BuildTek Events — .htaccess
# =====================================================

# --- Correct MIME types (critical for Safari/iOS) ---
AddType text/css .css
AddType application/javascript .js
AddType text/html .html
AddType image/svg+xml .svg
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  <FilesMatch "\.css$">
    Header set Content-Type "text/css; charset=UTF-8"
  </FilesMatch>
</IfModule>

# --- www to non-www canonical redirect ---
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.buildtek\.in [NC]
RewriteRule ^(.*)$ https://buildtek.in/$1 [R=301,L]

# --- Enforce HTTPS ---
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- Rewrite extensionless URLs to .html (e.g. /aisecsummit -> /aisecsummit.html) ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L,QSA]

# --- Custom error pages ---
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# --- Serve WebP images where supported ---
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
  RewriteRule ^(.*)\.(jpe?g|png)$ $1.webp [T=image/webp,L]
</IfModule>

<IfModule mod_headers.c>
  Header append Vary Accept env=REDIRECT_accept
</IfModule>

# --- Gzip compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Browser caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 1 hour"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/gif                 "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/xml           "access plus 1 week"
  ExpiresByType text/xml                  "access plus 1 week"
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# --- Block hotlinking (allow own domains, blank referrers, and search/social crawlers) ---
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?(buildtek\.in|pharmavistaglobal\.com) [NC]
RewriteCond %{HTTP_USER_AGENT} !(googlebot|bingbot|linkedinbot|twitterbot|facebookexternalhit|whatsapp|telegrambot|slackbot) [NC]
RewriteRule \.(jpg|jpeg|png|webp|gif|svg)$ - [F,L]

# --- Block internal directories and sensitive files ---
RewriteRule ^(_backups|_build|scratch)/ - [F,L]

<FilesMatch "\.(py|sh|sql|env|log|bak|backup|md|ya?ml)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Allow public AI discovery text manifests
<FilesMatch "^(llms|llms-full)\.txt$">
  Order allow,deny
  Allow from all
</FilesMatch>

# --- Redirect pharmavistaglobal.com (if served from same server) ---
# Handled at DNS level; canonical already set correctly

# --- Thank-you pages: no-index via header ---
<FilesMatch "(pharma-vista-thank-you|thank-you)\.html$">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
  </IfModule>
</FilesMatch>
